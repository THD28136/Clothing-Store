@model IEnumerable<MTKPM_Clothing_Store_web.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Danh sách đơn hàng</h1>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt hàng</th>
                <th>Số sản phẩm</th>
                <th>Tổng tiền</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var order in Model)
                {
                    var totalAmount = order.OrderDetails?.Sum(od => od.Quantity * od.Product?.Price ?? 0) ?? 0;
                    <tr>
                        <td>#@order.OrderId</td>
                        <td>@order.User?.Name</td>
                        <td>@order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.OrderDetails?.Count()</td>
                        <td>@totalAmount.ToString("C0")</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@order.OrderId">Xem chi tiết</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">Không có đơn hàng nào</td>
                </tr>
            }
        </tbody>
    </table>
</div>