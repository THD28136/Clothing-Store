@using System.Globalization
@model MTKPM_Clothing_Store_web.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    var totalAmount = Model.OrderDetails?.Sum(od => od.Quantity * od.Product?.Price ?? 0) ?? 0;
    var allowedStatuses = ViewBag.AllowedStatuses as string[] ?? new string[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
}

<div class="row">
    <div class="col-md-8">
        <h1>Chi tiết đơn hàng #@Model.OrderId</h1>

        <div class="card mb-4">
            <div class="card-body">
                <p><strong>Khách hàng:</strong> @Model.User?.Name</p>
                <p><strong>Email:</strong> @Model.User?.Email</p>
                <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Trạng thái:</strong> <span class="badge @(Model.Status == "Delivered" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">@((string.IsNullOrWhiteSpace(Model.Status) ? "Pending" : Model.Status))</span></p>
            </div>
        </div>

        <h5>Các sản phẩm trong đơn hàng</h5>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        @foreach (var detail in Model.OrderDetails)
                        {
                            var price = detail.Product?.Price ?? 0m;
                            var subtotal = (detail.Quantity * price);
                            <tr>
                                <td>@detail.Product?.Name</td>
                                <td>@price.ToString("C0", vn)</td>
                                <td>@detail.Quantity</td>
                                <td>@subtotal.ToString("C0", vn)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">Tóm tắt đơn hàng</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <span>Số lượng sản phẩm:</span>
                    <strong>@Model.OrderDetails?.Sum(od => od.Quantity)</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-3">
                    <span>Tổng cộng:</span>
                    <h5>@totalAmount.ToString("C0", vn)</h5>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <hr />
                    <h6>Thay đổi trạng thái</h6>
                    <form asp-action="UpdateStatus" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderId" />
                        <div class="input-group">
                            <select name="status" class="form-select">
                                @foreach (var st in allowedStatuses)
                                {
                                    if (string.Equals(st, Model.Status, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@st" selected>@st</option>
                                    }
                                    else
                                    {
                                        <option value="@st">@st</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">Cập nhật</button>
                        </div>
                    </form>
                }

                <div class="mt-3">
                    <a class="btn btn-outline-secondary w-100" asp-action="UserOrders">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>