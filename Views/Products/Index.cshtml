@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization
@model IEnumerable<MTKPM_Clothing_Store_web.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h1>Danh sách sản phẩm</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <input type="search" name="q" class="form-control" placeholder="Tìm kiếm..." value="@(ViewData["q"] ?? "")" />
    </div>

    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">Tất cả danh mục</option>
            @if (ViewBag.Categories is IEnumerable<SelectListItem> list)
            {
                foreach (var c in list)
                {
                    var isSelected = (ViewData["categoryId"]?.ToString() == c.Value);
                    if (isSelected)
                    {
                        <option value="@c.Value" selected>@c.Text</option>
                    }
                    else
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                }
            }
        </select>
    </div>

    <div class="col-auto">
        <input type="number" name="minPrice" class="form-control" placeholder="Giá từ" step="0.01" value="@(ViewData["minPrice"] ?? "")" />
    </div>

    <div class="col-auto">
        <input type="number" name="maxPrice" class="form-control" placeholder="Đến" step="0.01" value="@(ViewData["maxPrice"] ?? "")" />
    </div>

    <div class="col-auto">
        <select name="sort" class="form-select">
            <option value="">Sắp xếp</option>
            @{
                var sort = ViewData["sort"]?.ToString();
            }
            <option value="price_asc" selected="@(sort == "price_asc" ? "selected" : null)">Giá: thấp → cao</option>
            <option value="price_desc" selected="@(sort == "price_desc" ? "selected" : null)">Giá: cao → thấp</option>
            <option value="newest" selected="@(sort == "newest" ? "selected" : null)">Mới nhất</option>
        </select>
    </div>

    <div class="col-auto">
        <button class="btn btn-primary">Tìm</button>
    </div>
</form>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var product in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <img src="@(string.IsNullOrEmpty(product.Image) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + product.Image))" class="card-img-top" style="height: 250px; object-fit: cover;" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="text-muted small">@product.Category?.Name</p>

                        <div class="mb-2">
                            <strong>Giá:</strong> @product.Price.ToString("C0", new CultureInfo("vi-VN"))
                        </div>

                        <div class="mb-2">
                            @if (product.Stock > 10)
                            {
                                <span class="badge bg-success">Còn hàng (@product.Stock)</span>
                            }
                            else if (product.Stock > 0)
                            {
                                <span class="badge bg-warning">Còn lại @product.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            <a class="btn btn-sm btn-outline-primary flex-grow-1" asp-action="Details" asp-route-id="@product.ProductId">Chi tiết</a>
                            @if (product.Stock > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline flex-grow-1 ajax-add-to-cart">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Thêm vào giỏ</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary flex-grow-1" disabled>Hết hàng</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">Không có sản phẩm nào.</div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // Intercept Add-to-cart forms and send AJAX so we stay on page and show notification
            const forms = document.querySelectorAll('form.ajax-add-to-cart');
            forms.forEach(f => {
                f.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const form = e.currentTarget;
                    const data = new FormData(form);
                    try {
                        const resp = await fetch(form.action, {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            body: data
                        });
                        if (!resp.ok) throw new Error('Network error');
                        const json = await resp.json();
                        if (json?.success) {
                            showToast(json.message || 'Added to cart');
                            // update cart count badge if present
                            const badge = document.querySelector('.cart-count-badge');
                            if (badge && typeof json.cartCount !== 'undefined') badge.innerText = json.cartCount;
                        } else {
                            showToast('Không thể thêm vào giỏ: ' + (json?.message || 'Lỗi'), true);
                        }
                    } catch (err) {
                        showToast('Lỗi khi thêm vào giỏ.', true);
                        console.error(err);
                    }
                });
            });

            // Simple toast helper (injects a Bootstrap toast)
            function showToast(message, isError) {
                const id = 'toast-' + Math.random().toString(36).substr(2, 9);
                const toastHtml = `
<div id="${id}" class="toast align-items-center text-white ${isError ? 'bg-danger' : 'bg-success'} border-0" role="alert" aria-live="assertive" aria-atomic="true" style="position: fixed; top: 1rem; right: 1rem; z-index: 1200;">
  <div class="d-flex">
    <div class="toast-body">${message}</div>
    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
  </div>
</div>`;
                document.body.insertAdjacentHTML('beforeend', toastHtml);
                const el = document.getElementById(id);
                const bs = new bootstrap.Toast(el, { delay: 2500 });
                bs.show();
                el.addEventListener('hidden.bs.toast', () => el.remove());
            }
        })();
    </script>
}
