@using System.Globalization
@model IEnumerable<MTKPM_Clothing_Store_web.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categoriesSelect = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    string sort = ViewData["sort"] as string ?? "";
    string q = ViewData["q"] as string ?? "";
    int? selectedCategory = ViewData["categoryId"] as int?;
    decimal? minPrice = ViewData["minPrice"] as decimal?;
    decimal? maxPrice = ViewData["maxPrice"] as decimal?;
    var vn = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý sản phẩm</h1>
    <div>
        <a class="btn btn-success" asp-action="Create">Tạo sản phẩm mới</a>
    </div>
</div>

<div class="card mb-3 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-sm-3">
            <label class="form-label">Danh mục</label>
            <select name="categoryId" class="form-select">
                <option value="">Tất cả</option>
                @if (categoriesSelect != null)
                {
                    foreach (var c in categoriesSelect)
                    {
                        if (selectedCategory.HasValue && selectedCategory.Value.ToString() == c.Value)
                        {
                            <option value="@c.Value" selected>@c.Text</option>
                        }
                        else
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="col-sm-2">
            <label class="form-label">Giá từ</label>
            <input name="minPrice" class="form-control" type="number" step="0.01" value="@(minPrice?.ToString() ?? "")" />
        </div>
        <div class="col-sm-2">
            <label class="form-label">Giá đến</label>
            <input name="maxPrice" class="form-control" type="number" step="0.01" value="@(maxPrice?.ToString() ?? "")" />
        </div>

        <div class="col-sm-3">
            <label class="form-label">Sắp xếp</label>
            <select name="sort" class="form-select">
                @if (string.IsNullOrEmpty(sort))
                {
                    <option value="" selected>Mặc định (Tên)</option>
                }
                else
                {
                    <option value="">Mặc định (Tên)</option>
                }

                @if (sort == "price_asc")
                {
                    <option value="price_asc" selected>Giá: thấp → cao</option>
                }
                else
                {
                    <option value="price_asc">Giá: thấp → cao</option>
                }

                @if (sort == "price_desc")
                {
                    <option value="price_desc" selected>Giá: cao → thấp</option>
                }
                else
                {
                    <option value="price_desc">Giá: cao → thấp</option>
                }

                @if (sort == "name_asc")
                {
                    <option value="name_asc" selected>Tên: A → Z</option>
                }
                else
                {
                    <option value="name_asc">Tên: A → Z</option>
                }

                @if (sort == "name_desc")
                {
                    <option value="name_desc" selected>Tên: Z → A</option>
                }
                else
                {
                    <option value="name_desc">Tên: Z → A</option>
                }
            </select>
        </div>

        <div class="col-sm-2">
            <label class="form-label">Tìm</label>
            <div class="input-group">
                <input name="q" class="form-control" placeholder="Từ khóa" value="@q" />
                <button class="btn btn-primary" type="submit">Lọc</button>
            </div>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có sản phẩm.</div>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-6 col-md-3 mb-4">
                <div class="card h-100">
                    <img src="@(string.IsNullOrEmpty(product.Pic) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + product.Pic))" class="card-img-top" style="height:160px;object-fit:cover;" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title text-truncate">@product.Name</h6>
                        <p class="text-muted mb-1">@product.Category?.Name</p>
                        <p class="text-muted mb-2">@product.Price.ToString("C0", vn)</p>
                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@product.ProductId">Chi tiết</a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@product.ProductId">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@product.ProductId" method="post" onsubmit="return confirm('Xác nhận xóa sản phẩm này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}