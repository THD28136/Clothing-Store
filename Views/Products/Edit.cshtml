@model MTKPM_Clothing_Store_web.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.CategoryId as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<h2 class="mb-4">Sửa sản phẩm</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            <div class="col-md-4">
                <div class="mb-3 text-center">
                    <label class="form-label d-block">Ảnh hiện tại</label>
                    <img id="currentImage" src="@(string.IsNullOrEmpty(Model.Pic) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + Model.Pic))" class="img-fluid rounded" style="max-height:220px;object-fit:cover;" alt="@Model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Thay ảnh (PNG)</label>
                    <input type="file" name="ImageFile" id="imageFile" accept=".png" class="form-control" />
                    <div class="form-text">Chỉ nhận định dạng .png. Nếu không chọn, giữ ảnh hiện tại.</div>
                </div>

                <div class="form-check mt-2">
                    <input asp-for="IsFeatured" class="form-check-input" id="IsFeatured" />
                    <label asp-for="IsFeatured" class="form-check-label">Đánh dấu sản phẩm nổi bật</label>
                </div>
            </div>

            <div class="col-md-8">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-sm-4 mb-3">
                        <label asp-for="Price" class="form-label">Giá</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <label class="form-label">Danh mục</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="categories">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <label asp-for="Stock" class="form-label">Tồn kho</label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="AdminIndex" class="btn btn-secondary">Hủy</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post" onsubmit="return confirm('Xác nhận xóa sản phẩm này?');" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Xóa</button>
                        </form>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Preview image client-side
        document.getElementById('imageFile')?.addEventListener('change', function (e) {
            const file = this.files && this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                const img = document.getElementById('currentImage');
                if (img) img.src = ev.target.result;
            };
            reader.readAsDataURL(file);
        });
    </script>
}
