@model MTKPM_Clothing_Store_web.Models.Product

@{
    ViewData["Title"] = "Tạo sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.CategoryId as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<h2>Tạo sản phẩm</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="w-75">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" type="number" min="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Danh mục</label>
        <select asp-for="CategoryId" class="form-select" asp-items="categories">
            <option value="">-- Chọn danh mục --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Ảnh (PNG)</label>
        <input type="file" name="ImageFile" accept=".png" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Tạo</button>
    <button type="button" onclick="history.back()" class="btn btn-secondary">Hủy</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
