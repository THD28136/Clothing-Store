@using System.Globalization
@model MTKPM_Clothing_Store_web.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var vn = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="card mb-3">
    <div class="row g-0">
        <div class="col-md-4 text-center p-3">
            <img src="@(string.IsNullOrEmpty(Model.Pic) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + Model.Pic))" class="img-fluid rounded" style="max-height:320px;object-fit:cover;" alt="@Model.Name" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h3 class="card-title">@Model.Name</h3>
                <p class="text-muted mb-1"><strong>Danh mục:</strong> @Model.Category?.Name</p>
                <p class="text-muted mb-1"><strong>Giá:</strong> @Model.Price.ToString("C0", vn)</p>

                <div class="mb-2">
                    @if (Model.Stock > 10)
                    {
                        <p><span class="badge bg-success">Còn hàng - @Model.Stock sản phẩm có sẵn</span></p>
                    }
                    else if (Model.Stock > 0)
                    {
                        <p><span class="badge bg-warning">Chỉ còn @Model.Stock sản phẩm</span></p>
                    }
                    else
                    {
                        <p><span class="badge bg-danger">Hết hàng</span></p>
                    }
                </div>

                <hr />

                <h6>Mô tả</h6>
                <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "<em>Chưa có mô tả</em>" : Model.Description)</p>

                <div class="mt-4 d-flex gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.ProductId">Sửa</a>

                        <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post" onsubmit="return confirm('Xác nhận xóa sản phẩm này?');" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Xóa</button>
                        </form>
                    }
                    <a class="btn btn-outline-secondary" onclick="history.back(); return false;" href="#">Quay lại</a>
                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-primary">Thêm vào giỏ</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled>Hết hàng</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
