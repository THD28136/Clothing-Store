<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Đánh giá sản phẩm (@reviewCount)</h5>
    </div>
    <div class="card-body">
        @{
            bool canReview = ViewBag.CanReview == true;
        }
        @if (User.Identity != null && User.Identity.IsAuthenticated && canReview)
        {
            <h6>@(myReview != null ? "Cập nhật đánh giá của bạn" : "Viết đánh giá")</h6>
            <form asp-controller="Reviews" asp-action="Create" method="post" class="mb-4" id="review-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <div class="mb-2">
                    <label class="form-label d-block">Số sao</label>
                    <div class="star-rating">
                        @for (int s = 5; s >= 1; s--)
                        {
                            <input type="radio" id="star@(s)" name="rating" value="@s"
                                   checked="@(myReview != null && myReview.Rating == s ? "checked" : null)" required />
                            <label for="star@(s)" title="@s sao">★</label>
                        }
                    </div>
                </div>
                <style>
                                .star-rating {
                                    display: inline-flex;
                                    flex-direction: row-reverse;
                                    font-size: 2rem;
                                    line-height: 1;
                                }

                                    .star-rating input {
                                        display: none;
                                    }

                                    .star-rating label {
                                        color: #ccc;
                                        cursor: pointer;
                                        padding: 0 2px;
                                        transition: color 0.15s;
                                    }

                                        .star-rating input:checked ~ label,
                                        .star-rating label:hover,
                                        .star-rating label:hover ~ label {
                                            color: #ffc107;
                                        }
                </style>
                <div class="mb-2">
                    <label class="form-label">Nhận xét</label>
                    <textarea name="comment" class="form-control" rows="3" maxlength="1000">@(myReview?.Comment)</textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">@(myReview != null ? "Cập nhật đánh giá" : "Gửi đánh giá")</button>

                @if (myReview != null)
                {
                    <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@myReview.ReviewId" method="post" class="d-inline"
                          onsubmit="return confirm('Xóa đánh giá của bạn?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa đánh giá</button>
                    </form>
                }
            </form>
        }
        else if (User.Identity != null && User.Identity.IsAuthenticated && !canReview)
        {
            <p class="text-muted">Bạn cần <strong>đặt mua sản phẩm này</strong> trước khi có thể đánh giá.</p>
        }
        else
        {
            <p class="text-muted">
                <a asp-controller="Users" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Products", new { id = Model.ProductId })">Đăng nhập</a>
                và mua sản phẩm này để có thể viết đánh giá.
            </p>
        }

        <hr />

        @if (!reviews.Any())
        {
            <p class="text-muted mb-0">Chưa có đánh giá nào cho sản phẩm này.</p>
        }
        else
        {
            foreach (var r in reviews)
            {
                <div class="border-bottom py-2">
                    <div class="d-flex justify-content-between">
                        <strong>@(r.User?.Name ?? "Người dùng")</strong>
                        <span class="text-muted small">@r.ReviewDate?.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="text-warning">@Stars(r.Rating)</div>
                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                    {
                        <p class="mb-0">@r.Comment</p>
                    }
                    @if (myReview != null && myReview.ReviewId == r.ReviewId)
                    {
                        <div class="mt-1 d-flex gap-2">
                            <a href="#review-form" class="btn btn-outline-primary btn-sm">Sửa</a>
                            <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.ReviewId" method="post" class="m-0"
                                  onsubmit="return confirm('Xóa đánh giá của bạn?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                            </form>
                        </div>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.ReviewId" method="post" class="mt-1"
                              onsubmit="return confirm('Xóa đánh giá này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Xóa (Admin)</button>
                        </form>
                    }
                </div>
            }
        }
    </div>
</div>