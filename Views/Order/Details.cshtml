@model MTKPM_Clothing_Store_web.Models.Order

<h2>🧾 Đơn hàng #@Model.OrderId</h2>

<p>
    <strong>Trạng thái:</strong>
    <span class="badge bg-warning">@Model.Status</span>
</p>

<p>
    <strong>Tổng tiền:</strong>
    <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</span>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Hình</th>
            <th>Sản phẩm</th>
            <th>Giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>
                    <img src="@item.Product?.Pic" width="80" />
                </td>
                <td>
                    @item.Product?.Name
                </td>
                <td>
                    @item.Price.ToString("N0")
                </td>
                <td>
                    @item.Quantity
                </td>
                <td>
                    @(item.Price* item.Quantity)
                </td>
            </tr>
        }
    </tbody>
</table>