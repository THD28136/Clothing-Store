@model IEnumerable<MTKPM_Clothing_Store_web.Models.Order>

<h2>📦 Đơn hàng của tôi</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Ngày</th>
            <th>Trạng thái</th>
            <th>Tổng tiền</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.OrderId</td>
                <td>@item.OrderDate</td>
                <td>
                    <span class="badge bg-info">@item.Status</span>
                </td>
                <td class="text-danger">
                    @item.TotalAmount.ToString("N0") VNĐ
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-primary">
                        Xem
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>