@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var email = ViewBag.Email as string ?? string.Empty;
    var debugCode = ViewBag.DebugResetCode as string;
    var message = ViewBag.Message as string;
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>@ViewData["Title"]</h2>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-info">@message</div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" value="@email" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Gửi mã đặt lại</button>
            <a asp-action="Login" class="btn btn-link ms-2">Back to login</a>
        </form>

        @if (!string.IsNullOrEmpty(debugCode))
        {
            <hr />
            <div class="alert alert-warning">
                <strong>DEBUG:</strong> Mã đặt lại (hiển thị cho môi trường client/dev): <code>@debugCode</code><br />
                Sử dụng mã này trên trang <a asp-action="ResetPassword">Reset Password</a>.
            </div>
        }
    </div>
</div>