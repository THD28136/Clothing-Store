@model MTKPM_Clothing_Store_web.Models.User

@{
    ViewData["Title"] = "Thông tin người dùng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>Thông tin người dùng</h2>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Tên</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Vai trò</dt>
            <dd class="col-sm-9">@Model.Role</dd>
        </dl>

        <button type="button" onclick="history.back()" class="btn btn-outline-secondary">Quay lại</button>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.UserId">Chỉnh sửa</a>
    </div>
</div>
