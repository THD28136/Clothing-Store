@model List<MTKPM_Clothing_Store_web.Models.ShippingAddress>
@{
    ViewData["Title"] = "Sổ địa chỉ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var returnTo = (ViewData["ReturnTo"] as string) ?? "";
    var selectedId = ViewData["SelectedId"] as int?;
}

<div style="max-width:800px;margin:0 auto;padding:32px 16px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h2 style="margin:0;">Sổ địa chỉ</h2>
        <div style="display:flex;gap:8px;align-items:center;">
            @if (returnTo == "checkout")
            {
                <a class="btn btn-outline-secondary" href="javascript:window.close()">Đóng</a>
            }
            <a class="btn btn-dark" asp-action="Create" asp-route-returnTo="@(returnTo == "checkout" ? "checkout" : null)">+ Thêm địa chỉ mới</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div style="border:1px dashed #d8cec6;border-radius:4px;padding:40px;text-align:center;color:#8a7f78;">
            Bạn chưa có địa chỉ nào được lưu.
            <div style="margin-top:14px;">
                <a class="btn btn-dark" asp-action="Create" asp-route-returnTo="@(returnTo == "checkout" ? "checkout" : null)">+ Thêm địa chỉ đầu tiên</a>
            </div>
        </div>
    }
    else
    {
        foreach (var addr in Model)
        {
            <div id="addr-@addr.AddressId" style="border:1px solid #e2dcd6;border-radius:4px;padding:20px;margin-bottom:14px;background:@(addr.IsDefault ? "#fbfaf8" : "#fff");">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px;">
                    <div>
                        <strong>@addr.ReceiverName</strong>
                        <span style="margin-left:10px;color:#8a7f78;">@addr.PhoneNumber</span>
                        @if (!string.IsNullOrEmpty(addr.AddressLabel))
                        {
                            <span style="margin-left:10px;font-size:12px;border:1px solid #d8cec6;border-radius:999px;padding:2px 10px;color:#6b625d;">@addr.AddressLabel</span>
                        }
                        @if (addr.IsDefault)
                        {
                            <span style="margin-left:8px;font-size:11px;border:1px solid #1a1a1a;border-radius:999px;padding:3px 10px;text-transform:uppercase;letter-spacing:.1em;">Mặc định</span>
                        }
                        <p style="margin:8px 0 0;color:#4a423e;">@addr.Street, @addr.Ward, @addr.Province</p>
                    </div>
                    <div style="display:flex;gap:8px;flex-shrink:0;">
                        @if (returnTo == "checkout")
                        {
                            <button type="button" class="btn btn-sm btn-primary choose-btn"
                                    data-id="@addr.AddressId"
                                    data-name="@addr.ReceiverName"
                                    data-phone="@addr.PhoneNumber"
                                    data-street="@addr.Street"
                                    data-ward="@addr.Ward"
                                    data-province="@addr.Province"
                                    data-label="@addr.AddressLabel">
                                Chọn
                            </button>
                        }
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@addr.AddressId">Sửa</a>
                        @if (!addr.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@addr.AddressId" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-dark">Đặt mặc định</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@addr.AddressId" method="post" class="m-0"
                              onsubmit="return confirm('Xóa địa chỉ này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (returnTo == "checkout")
{
    <script>
        (function () {
            function buildAddressFromEl(el) {
                return {
                    addressId: parseInt(el.getAttribute('data-id')),
                    receiverName: el.getAttribute('data-name'),
                    phoneNumber: el.getAttribute('data-phone'),
                    street: el.getAttribute('data-street'),
                    ward: el.getAttribute('data-ward'),
                    province: el.getAttribute('data-province'),
                    label: el.getAttribute('data-label')
                };
            }

            // attach handlers for manual choose clicks
            document.querySelectorAll('.choose-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var addr = buildAddressFromEl(btn);
                    try {
                        if (window.opener && !window.opener.closed) {
                            window.opener.postMessage({ type: 'addressSelected', address: addr }, window.location.origin);
                        }
                    } catch (e) {
                        console.error(e);
                    }
                    window.close();
                });
            });

            // If server indicated a newly created selected id, auto-send it
            var preselected = @Html.Raw(selectedId.HasValue ? selectedId.Value.ToString() : "null");
            if (preselected !== null) {
                var el = document.getElementById('addr-' + preselected);
                if (el) {
                    var btn = el.querySelector('.choose-btn');
                    if (btn) {
                        // small timeout to ensure opener is ready
                        setTimeout(function () {
                            btn.click();
                        }, 100);
                    }
                }
            }
        })();
    </script>
}