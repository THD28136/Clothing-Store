@model MTKPM_Clothing_Store_web.Models.Coupon

@{
    ViewData["Title"] = "Xóa mã giảm giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Xóa mã giảm giá</h1>

<div class="alert alert-warning">
    Bạn có chắc muốn xóa mã <strong>@Model.Code</strong> (@Model.CouponName)?
    Đã sử dụng @Model.UsedCount lần. Việc này không thể hoàn tác.
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CouponId" />
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>
