@model IEnumerable<MTKPM_Clothing_Store_web.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Danh sách danh mục</h1>
    <a class="btn btn-outline-primary" asp-action="Create">Tạo danh mục mới</a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã danh mục</th>
                <th>Tên danh mục</th>
                <th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.CategoryId</td>
                        <td>@item.Name</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.CategoryId">Sửa</a>
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.CategoryId">Chi tiết</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.CategoryId">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">Không có danh mục nào</td>
                </tr>
            }
        </tbody>
    </table>
</div>
