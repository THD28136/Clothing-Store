@model IEnumerable<MTKPM_Clothing_Store_web.Models.Category>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    // Tập hợp sản phẩm nổi bật từ các category đã nạp
    var featured = Model.SelectMany(c => c.Products).Where(p => p.IsFeatured).OrderByDescending(p => p.Price).Take(12).ToList();
}

<style>
    /* Scroll container for horizontal product rows */
    .product-row {
        overflow-x: auto;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 8px;

        /* hide scrollbar while keeping scrolling usable */
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;     /* Firefox */
    }
    /* Chrome, Safari, Opera */
    .product-row::-webkit-scrollbar {
        height: 0;
        display: none;
    }

    /* Card: cố định kích thước, hiển thị inline để cuộn ngang */
    .product-card {
        display: inline-block;
        white-space: normal;
        width: 200px;
        margin-right: 12px;
        vertical-align: top;
    }

    /* Đặt chiều cao cố định cho khung card để mọi card đồng đều */
    .product-card .card {
        width: 100%;
        height: 260px; /* tổng chiều cao card (ảnh + body) */
        display: flex;
        flex-direction: column;
        border-radius: 6px;
        overflow: hidden;
    }

    /* Khung chứa ảnh: cố định chiều cao, overflow hidden */
    .product-card .img-wrap {
        height: 140px;
        width: 100%;
        overflow: hidden;
        flex: 0 0 140px;
        background-color: #f8f9fa;
    }

    /* Ảnh luôn phủ kín khung, được crop đều */
    .product-card .img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Body có chiều cao cố định, bố trí nội dung theo cột, nút ở dưới */
    .product-card .card-body {
        padding: 8px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1 1 auto;
    }

    .product-card .card-body .card-top {
        /* phần chứa tiêu đề + giá */
    }

    .product-card .card-title {
        font-size: 0.95rem;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .product-card .card-price {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .product-card .card-actions {
        display: flex;
        gap: 6px;
        margin-top: 6px;
    }

    .banner {
        position: relative;
        background-size: cover;
        background-position: center;
        height: 300px;
        border-radius: 6px;
        margin-bottom: 24px;
        color: white;
    }

    .banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.35));
        border-radius: 6px;
    }
    .banner-content {
        position: absolute;
        left: 40px;
        top: 50%;
        transform: translateY(-50%);
    }
</style>

<h1 class="mb-3">Chào mừng tới Clothing Store</h1>

<!-- Banner dưới navbar -->
<div class="banner" style="background-image: url('/images/H_FASHION.jpg'); background-size:auto">
    <div class="banner-overlay"></div>
    <div class="banner-content">
        <h1 class="display-5">Mùa mới đã có mặt</h1>
        <p class="lead">Khám phá bộ sưu tập mới — giảm giá đến 30% cho các sản phẩm chọn lọc.</p>
        <a class="btn btn-primary btn-lg" asp-controller="Products" asp-action="Index">Mua ngay</a>
    </div>
</div>

<!-- Danh mục + hàng sản phẩm ngang có thể scroll -->
@if (featured.Any())
{
    <section class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="mb-0">Sản phẩm nổi bật</h4>
            <a class="small text-decoration-none" asp-controller="Products" asp-action="Index">Xem tất cả</a>
        </div>

        <div class="product-row">
            @foreach (var p in featured)
            {
                <div class="product-card">
                    <div class="card">
                        <div class="img-wrap">
                            <img src="@(string.IsNullOrEmpty(p.Pic) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + p.Pic))" alt="@p.Name" />
                        </div>
                        <div class="card-body">
                            <div>
                                <h6 class="card-title">@p.Name</h6>
                                <p class="card-price mb-1">@p.Price.ToString("C0")</p>
                            </div>
                            <div class="card-actions">
                                <a class="btn btn-sm btn-outline-primary flex-grow-1" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId">Chi tiết</a>
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-sm btn-primary">Thêm vào giỏ</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- Các danh mục như cũ -->
@foreach (var category in Model)
{
    <section class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="mb-0">@category.Name</h4>
            <a class="small text-decoration-none" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.CategoryId">Xem tất cả</a>
        </div>

        <div class="product-row">
            @foreach (var product in category.Products.Take(12))
            {
                <div class="product-card">
                    <div class="card">
                        <div class="img-wrap">
                            <img src="@(string.IsNullOrEmpty(product.Pic) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + product.Pic))" alt="@product.Name" />
                        </div>
                        <div class="card-body">
                            <div class="card-top">
                                <h6 class="card-title">@product.Name</h6>
                                <p class="card-price mb-1">@product.Price.ToString("C0")</p>
                            </div>

                            <div class="card-actions">
                                <a class="btn btn-sm btn-outline-primary flex-grow-1" asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId">Chi tiết</a>

                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-sm btn-primary">Thêm vào giỏ</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}