@using System.Globalization
@model IEnumerable<MTKPM_Clothing_Store_web.Models.Category>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var featured = Model.SelectMany(c => c.Products).Where(p => p.IsFeatured).OrderByDescending(p => p.Price).Take(12).ToList();
    var vnd = new CultureInfo("vi-VN");
}

<style>
    /* ---------- Boutique tokens (match layout) ---------- */
    :root {
        --ink: #1a1a1a;
        --muted: #8a8a8a;
        --line: #ececec;
        --bg-soft: #faf8f5;
        --accent: #1a1a1a;
    }

    body { background: #fff; }

    /* ---------- Hero ---------- */
    .hero {
        position: relative;
        height: 560px;
        margin: 0 0 72px;
        overflow: hidden;
        background-size: cover;
        background-position: center;
        color: #fff;
    }
    .hero::after {
        content: "";
        position: absolute; inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,.15) 60%, rgba(0,0,0,0) 100%);
    }
    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 560px;
        padding: 0 64px;
        top: 50%;
        transform: translateY(-50%);
    }
    .hero-eyebrow {
        font-size: .72rem;
        letter-spacing: .32em;
        text-transform: uppercase;
        opacity: .85;
        margin-bottom: 18px;
    }
    .hero-title {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 500;
        font-size: 3.6rem;
        line-height: 1.05;
        letter-spacing: -.01em;
        margin-bottom: 20px;
    }
    .hero-lead {
        font-size: 1.02rem;
        opacity: .92;
        margin-bottom: 32px;
        max-width: 440px;
    }
    .btn-boutique {
        display: inline-block;
        background: #fff;
        color: #1a1a1a;
        border: none;
        padding: 14px 38px;
        font-size: .78rem;
        letter-spacing: .22em;
        text-transform: uppercase;
        font-weight: 600;
        border-radius: 0;
        transition: all .25s ease;
    }
    .btn-boutique:hover { background: #1a1a1a; color: #fff; }

    .btn-boutique-outline {
        display: inline-block;
        background: transparent;
        color: #1a1a1a;
        border: 1px solid #1a1a1a;
        padding: 13px 34px;
        font-size: .74rem;
        letter-spacing: .22em;
        text-transform: uppercase;
        font-weight: 600;
        border-radius: 0;
        transition: all .25s ease;
    }
    .btn-boutique-outline:hover { background: #1a1a1a; color: #fff; }

    /* ---------- Section headings ---------- */
    .section { margin-bottom: 80px; }
    .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 32px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--line);
    }
    .section-eyebrow {
        font-size: .68rem;
        letter-spacing: .3em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
    }
    .section-title {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 500;
        font-size: 1.9rem;
        letter-spacing: -.01em;
        color: var(--ink);
        margin: 0;
    }
    .section-link {
        font-size: .72rem;
        letter-spacing: .22em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 2px;
        transition: opacity .2s;
    }
    .section-link:hover { opacity: .55; color: var(--ink); }

    /* ---------- Product row (horizontal scroll) ---------- */
    .product-row {
        display: flex;
        gap: 24px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 8px;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .product-row::-webkit-scrollbar { display: none; height: 0; }

    /* ---------- Product card ---------- */
    /* thay thế block .product-card cũ bằng block này */

.product-card {
    flex: 0 0 240px;
    scroll-snap-align: start;
    background: transparent;
}
.product-card .card {
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
    display: flex;
    flex-direction: column;
    height: 100%;
}
.product-card .img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-soft);
    margin-bottom: 14px;
    flex-shrink: 0;
}
.product-card .img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .7s ease;
}
.product-card:hover .img-wrap img { transform: scale(1.05); }

.product-card .quick-add {
    position: absolute;
    left: 12px; right: 12px; bottom: 12px;
    background: #fff;
    color: #1a1a1a;
    border: none;
    padding: 11px 12px;
    font-size: .7rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0;
    transform: translateY(8px);
    transition: all .3s ease;
    cursor: pointer;
}
.product-card:hover .quick-add { opacity: 1; transform: translateY(0); }
.product-card .quick-add:hover { background: #1a1a1a; color: #fff; }

.product-card .card-title {
    font-size: .92rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 6px;
    letter-spacing: .01em;
    /* cho phép 2 dòng, cắt bằng dấu ... để card đều nhau */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
    line-height: 1.3em;
}
.product-card .card-title a { color: inherit; text-decoration: none; }
.product-card .card-title a:hover { opacity: .6; }
.product-card .card-price {
    font-size: .88rem;
    color: var(--ink);
    margin: 0;
    letter-spacing: .02em;
}
.product-card .stock-tag {
    display: inline-block;
    font-size: .65rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
}
.product-card .stock-tag.oos { color: #b23a3a; }

/* thêm dòng này để các item trong hàng cùng cao bằng nhau */
.product-row {
    align-items: stretch;
}
    .badge-featured {
        position: absolute;
        top: 12px; left: 12px;
        background: #1a1a1a;
        color: #fff;
        font-size: .6rem;
        letter-spacing: .22em;
        text-transform: uppercase;
        padding: 5px 10px;
        font-weight: 600;
        z-index: 2;
    }

    /* ---------- Value strip ---------- */
    .value-strip {
        background: var(--bg-soft);
        padding: 44px 0;
        margin: 0 0 80px;
    }
    .value-item {
        text-align: center;
        padding: 0 20px;
    }
    .value-item i {
        font-size: 1.6rem;
        color: var(--ink);
        margin-bottom: 10px;
        display: block;
    }
    .value-item .v-title {
        font-size: .78rem;
        letter-spacing: .2em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 4px;
    }
    .value-item .v-sub {
        font-size: .82rem;
        color: var(--muted);
        margin: 0;
    }

    /* ---------- Editorial split ---------- */
    .editorial {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        margin-bottom: 80px;
        min-height: 460px;
    }
    .editorial-img {
        background-size: cover;
        background-position: center;
        min-height: 420px;
    }
    .editorial-body {
        background: var(--bg-soft);
        padding: 70px 64px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .editorial-body .section-eyebrow { color: var(--muted); }
    .editorial-body h2 {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 500;
        font-size: 2.2rem;
        line-height: 1.15;
        margin: 4px 0 18px;
        color: var(--ink);
    }
    .editorial-body p {
        color: #555;
        font-size: .98rem;
        line-height: 1.7;
        margin-bottom: 28px;
        max-width: 420px;
    }

    @@media (max-width: 768px) {
        .hero { height: 460px; }
        .hero-content { padding: 0 24px; }
        .hero-title { font-size: 2.4rem; }
        .section-title { font-size: 1.5rem; }
        .editorial { grid-template-columns: 1fr; }
        .editorial-body { padding: 44px 28px; }
        .product-card { flex: 0 0 180px; }
    }
</style>

<!-- ============ HERO ============ -->
<section class="hero" style="background-image: url('/images/H_FASHION.jpg');">
    <div class="hero-content">
        <div class="hero-eyebrow">Bộ sưu tập Thu / Đông</div>
        <h1 class="hero-title">Mùa mới<br/>đã có mặt.</h1>
        <p class="hero-lead">Khám phá những thiết kế được chọn lọc — giảm đến 30% cho các mẫu chọn lọc trong tuần này.</p>
        <a class="btn-boutique" asp-controller="Products" asp-action="Index">Mua ngay</a>
    </div>
</section>

<div class="container">

    <!-- ============ FEATURED ============ -->
    @if (featured.Any())
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <div class="section-eyebrow">Được chọn lọc</div>
                    <h2 class="section-title">Sản phẩm nổi bật</h2>
                </div>
                <a class="section-link" asp-controller="Products" asp-action="Index">Xem tất cả</a>
            </div>

            <div class="product-row">
                @foreach (var p in featured)
                {
                    <div class="product-card">
                        <div class="card">
                            <div class="img-wrap">
                                <span class="badge-featured">Nổi bật</span>
                                <img src="@(string.IsNullOrEmpty(p.Image) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + p.Image))" alt="@p.Name" />
                                <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="quick-add">Thêm vào giỏ</button>
                                </form>
                            </div>
                            <h6 class="card-title">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId">@p.Name</a>
                            </h6>
                            <p class="card-price">@p.Price.ToString("C0", vnd)</p>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ============ EDITORIAL ============ -->
    <section class="editorial">
        <div class="editorial-img" style="background-image: url('/images/H_FASHION.jpg');"></div>
        <div class="editorial-body">
            <div class="section-eyebrow">Câu chuyện LOVSTORE</div>
            <h2>Thiết kế tinh tế<br/>cho mỗi khoảnh khắc.</h2>
            <p>Chúng tôi tuyển chọn từng thiết kế với sự chú trọng đến chất liệu, phom dáng và độ bền — để bạn mặc lâu, mặc đẹp, và mặc đúng chất riêng.</p>
            <div>
                <a class="btn-boutique-outline" asp-controller="Products" asp-action="Index">Khám phá</a>
            </div>
        </div>
    </section>

</div>

<!-- ============ VALUE STRIP ============ -->
<section class="value-strip">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="value-item">
                    <i class="bi bi-truck"></i>
                    <div class="v-title">Miễn phí giao</div>
                    <p class="v-sub">Cho đơn từ 500.000₫</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="value-item">
                    <i class="bi bi-arrow-repeat"></i>
                    <div class="v-title">Đổi trả 30 ngày</div>
                    <p class="v-sub">Đơn giản, nhanh chóng</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="value-item">
                    <i class="bi bi-shield-check"></i>
                    <div class="v-title">Chính hãng</div>
                    <p class="v-sub">Cam kết 100%</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="value-item">
                    <i class="bi bi-headset"></i>
                    <div class="v-title">Hỗ trợ 24/7</div>
                    <p class="v-sub">Luôn sẵn sàng cho bạn</p>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container">

    <!-- ============ CATEGORIES ============ -->
    @foreach (var category in Model)
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <div class="section-eyebrow">Danh mục</div>
                    <h2 class="section-title">@category.Name</h2>
                </div>
                <a class="section-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.CategoryId">Xem tất cả</a>
            </div>

            <div class="product-row">
                @foreach (var product in category.Products.Take(12))
                {
                    <div class="product-card">
                        <div class="card">
                            <div class="img-wrap">
                                <img src="@(string.IsNullOrEmpty(product.Image) ? Url.Content("~/images/PlaceHolder.png") : Url.Content("~/" + product.Image))" alt="@product.Name" />
                                @if (product.Stock > 0)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@product.ProductId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="quick-add">Thêm vào giỏ</button>
                                    </form>
                                }
                            </div>
                            <h6 class="card-title">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId">@product.Name</a>
                            </h6>
                            <p class="card-price">@product.Price.ToString("C0", vnd)</p>
                            @if (product.Stock > 0)
                            {
                                <span class="stock-tag">Còn @product.Stock sản phẩm</span>
                            }
                            else
                            {
                                <span class="stock-tag oos">Hết hàng</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

</div>
