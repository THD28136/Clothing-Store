@model IEnumerable<MTKPM_Clothing_Store_web.Models.Order>

<h2>📦 Quản lý đơn hàng</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Khách</th>
            <th>Ngày</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.OrderId</td>
                <td>@item.User?.Name</td>
                <td>@item.OrderDate</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="UpdateStatus" asp-route-id="@item.OrderId" asp-route-status="Shipping">Giao</a> |
                    <a asp-action="UpdateStatus" asp-route-id="@item.OrderId" asp-route-status="Completed">Xong</a> |
                    <a asp-action="UpdateStatus" asp-route-id="@item.OrderId" asp-route-status="Cancelled">Hủy</a>
                </td>
            </tr>
        }
    </tbody>
</table>