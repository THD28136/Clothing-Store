@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var userName = User?.Identity?.Name ?? HttpContextAccessor.HttpContext?.Session.GetString("Name");
    var userId = HttpContextAccessor.HttpContext?.Session.GetString("UserId");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LOVSTORE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --ink: #14100e;
            --ink-soft: #6b6360;
            --line: #e7e2dd;
            --paper: #fbfaf8;
            --accent: #8a6a4f;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
            color: var(--ink);
            background: var(--paper);
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, .display-serif {
            font-family: 'Playfair Display', Georgia, serif;
            letter-spacing: -0.01em;
        }

        a {
            text-decoration: none;
        }

        /* ---------- Announcement ---------- */
        .lv-announce {
            background: var(--ink);
            color: #f4efe9;
            font-size: .72rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            text-align: center;
            padding: .6rem 1rem;
        }

        /* ---------- Shared nav ---------- */
        .lv-nav {
            background: #fff;
            border-bottom: 1px solid var(--line);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .lv-brand {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: .22em;
            color: var(--ink) !important;
            text-transform: uppercase;
        }

            .lv-brand small {
                display: block;
                font-family: 'Inter', sans-serif;
                font-size: .58rem;
                letter-spacing: .3em;
                color: var(--ink-soft);
                font-weight: 500;
                margin-top: 2px;
            }

        .lv-link {
            color: var(--ink) !important;
            font-size: .78rem;
            letter-spacing: .14em;
            text-transform: uppercase;
            font-weight: 500;
            padding: .5rem .9rem !important;
            position: relative;
        }

            .lv-link::after {
                content: "";
                position: absolute;
                left: .9rem;
                right: .9rem;
                bottom: .25rem;
                height: 1px;
                background: var(--ink);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform .35s ease;
            }

            .lv-link:hover::after {
                transform: scaleX(1);
            }

        .dropdown-menu {
            border: 1px solid var(--line);
            border-radius: 0;
            box-shadow: 0 18px 40px rgba(20,16,14,.08);
            padding: .4rem 0;
            font-size: .85rem;
        }

        .dropdown-item {
            padding: .55rem 1.1rem;
            color: var(--ink);
        }

            .dropdown-item:hover {
                background: var(--paper);
                color: var(--accent);
            }

            .dropdown-item i {
                width: 1.1rem;
                color: var(--ink-soft);
            }

        /* ---------- Admin shell ---------- */
        .lv-admin-shell {
            min-height: 100vh;
        }

        .lv-sidebar {
            background: #fff;
            border-right: 1px solid var(--line);
            min-height: calc(100vh - 66px);
            padding: 2rem 1.25rem;
        }

        .lv-sidebar-label {
            font-size: .62rem;
            letter-spacing: .26em;
            text-transform: uppercase;
            color: var(--ink-soft);
            margin-bottom: 1rem;
        }

        .lv-side-link {
            display: flex;
            align-items: center;
            gap: .7rem;
            padding: .65rem .8rem;
            color: var(--ink);
            font-size: .88rem;
            border-left: 2px solid transparent;
            transition: all .25s ease;
        }

            .lv-side-link i {
                color: var(--ink-soft);
                font-size: 1rem;
            }

            .lv-side-link:hover {
                background: var(--paper);
                border-left-color: var(--accent);
                color: var(--accent);
            }

                .lv-side-link:hover i {
                    color: var(--accent);
                }

        .lv-admin-main {
            padding: 2.5rem 3rem;
        }

        /* ---------- Footer ---------- */
        .lv-footer {
            border-top: 1px solid var(--line);
            background: #fff;
            padding: 2.25rem 0;
            margin-top: 4rem;
            font-size: .82rem;
            color: var(--ink-soft);
        }

            .lv-footer a {
                color: var(--ink);
                border-bottom: 1px solid var(--line);
            }

                .lv-footer a:hover {
                    color: var(--accent);
                    border-color: var(--accent);
                }

        @@media (max-width: 991.98px) {
            .lv-sidebar {
                min-height: auto;
                border-right: 0;
                border-bottom: 1px solid var(--line);
            }

            .lv-admin-main {
                padding: 1.75rem 1.25rem;
            }
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    @if (isAdmin)
    {
        <nav class="lv-nav">
            <div class="container-fluid px-4 d-flex align-items-center justify-content-between" style="height:66px;">
                <a class="lv-brand" asp-controller="Home" asp-action="Index">
                    LOVSTORE
                    <small>Bảng điều khiển quản trị</small>
                </a>
                <div class="dropdown">
                    <a class="lv-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="adminUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i><span>@userName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminUserDropdown">
                        <li>
                            <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword" asp-route-id="@userId">
                                <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Users" asp-action="Logout" method="post" class="d-inline w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container-fluid lv-admin-shell flex-grow-1">
            <div class="row g-0">
                <aside class="col-lg-2 lv-sidebar">
                    <div class="lv-sidebar-label">Quản lý</div>
                    <nav class="d-flex flex-column gap-1">
                        <a class="lv-side-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i> Dashboard</a>
                        <a class="lv-side-link" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Người dùng</a>
                        <a class="lv-side-link" asp-controller="Products" asp-action="AdminIndex"><i class="bi bi-bag"></i> Sản phẩm</a>
                        <a class="lv-side-link" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Danh mục</a>
                        <a class="lv-side-link" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng</a>
                        <a class="lv-side-link" asp-controller="Coupons" asp-action="Index"><i class="bi bi-ticket-perforated"></i> Mã giảm giá</a>
                    </nav>
                </aside>

                <main role="main" class="col-lg-10 lv-admin-main">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="lv-announce">Miễn phí giao hàng cho đơn từ 500.000₫ · Đổi trả trong 30 ngày</div>

        <header>
            <nav class="lv-nav navbar navbar-expand-lg py-2">
                <div class="container">
                    <a class="lv-brand navbar-brand" asp-controller="Home" asp-action="Index">
                        LOVSTORE
                        <small>Thời trang chọn lọc</small>
                    </a>

                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <i class="bi bi-list fs-3"></i>
                    </button>

                    <div class="navbar-collapse collapse">
                        <ul class="navbar-nav mx-auto">
                            <li class="nav-item"><a class="nav-link lv-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                            <li class="nav-item"><a class="nav-link lv-link" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                            <li class="nav-item"><a class="nav-link lv-link" asp-controller="Categories" asp-action="Index">Danh mục</a></li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            @if (isAuthenticated)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link lv-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person"></i> @userName
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Users" asp-action="Details" asp-route-id="@userId">
                                                <i class="bi bi-person"></i> Thông tin người dùng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword" asp-route-id="@userId">
                                                <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Orders" asp-action="UserOrders">
                                                <i class="bi bi-receipt"></i> Lịch sử đặt hàng
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Users" asp-action="Logout" method="post" class="d-inline w-100">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link lv-link" asp-controller="Users" asp-action="Login">Đăng nhập</a></li>
                                <li class="nav-item"><a class="nav-link lv-link" asp-controller="Users" asp-action="Register">Đăng ký</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container flex-grow-1">
            <main role="main" class="pb-3 pt-4">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="lv-footer mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year LOVSTORE. Bảo lưu mọi quyền.</span>
            <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
