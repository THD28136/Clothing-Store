@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var userName = User?.Identity?.Name ?? HttpContextAccessor.HttpContext?.Session.GetString("Name");
    var userId = HttpContextAccessor.HttpContext?.Session.GetString("UserId");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAdmin)
    {
        <!-- Admin navbar + sidebar -->
        <nav class="navbar navbar-dark bg-dark" >
            <div class="container-fluid" >
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">LOVSTORE - ADMIN</a>
                <div class="d-flex">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light" href="#" id="adminUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span>@userName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminUserDropdown">
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Users" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
        
        <div class="container-fluid">
            <div class="row">
                <aside class="col-2 bg-light vh-100 border-end pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">Người dùng</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Products" asp-action="AdminIndex">Sản phẩm</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">Danh mục</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Orders" asp-action="Index">Đơn hàng</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Coupons" asp-action="Index">Mã giảm giá</a>
                        </li>
                    </ul>
                </aside>

                <main role="main" class="col-10 p-4">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Customer header -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">LOVSTORE</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Products" asp-action="Index">Sản phẩm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Categories" asp-action="Index">Danh mục</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            @if (isAuthenticated)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Xin chào, @userName
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Users" asp-action="Details" asp-route-id="@userId">
                                                <i class="bi bi-person"></i> Thông tin người dùng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Orders" asp-action="UserOrders">
                                                <i class="bi bi-receipt"></i> Lịch sử đặt hàng
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Users" asp-action="Logout" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Users" asp-action="Login">Đăng nhập</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Users" asp-action="Register">Đăng ký</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - LOVSTORE - <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
