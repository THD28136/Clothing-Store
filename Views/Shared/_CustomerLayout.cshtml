@using Microsoft.AspNetCore.Http
@using MTKPM_Clothing_Store_web.Helpers
@using MTKPM_Clothing_Store_web.Models
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("Name") ?? User.Identity?.Name;
    var userId = HttpContextAccessor.HttpContext?.Session.GetString("UserId")
                 ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role")
                   ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                   ?? (User?.IsInRole("Admin") == true ? "Admin" : "customer");
    var cart = HttpContextAccessor.HttpContext?.Session.GetObject<List<SessionCartItem>>("Cart") ?? new List<SessionCartItem>();
    var cartCount = cart.Sum(i => i.Quantity);
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LOVSTORE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --lov-bg: #faf8f5;
            --lov-surface: #ffffff;
            --lov-ink: #1a1a1a;
            --lov-muted: #6b6b6b;
            --lov-line: #ececec;
            --lov-accent: #b8895a;
            --lov-accent-dark: #8a6640;
        }

        html, body { height: 100%; }
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--lov-bg);
            color: var(--lov-ink);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            letter-spacing: 0.01em;
        }

        .lov-announce {
            background: var(--lov-ink);
            color: #f5f1ea;
            font-size: 12px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-align: center;
            padding: 8px 12px;
        }

        .lov-nav {
            background: var(--lov-surface);
            border-bottom: 1px solid var(--lov-line);
            padding: 14px 0;
            position: sticky;
            top: 0;
            z-index: 1030;
            backdrop-filter: saturate(1.2) blur(8px);
        }

        .lov-brand {
            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 600;
            font-size: 1.9rem;
            letter-spacing: 0.24em;
            color: var(--lov-ink) !important;
            text-transform: uppercase;
        }

        .lov-nav .nav-link {
            color: var(--lov-ink) !important;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            padding: 8px 14px !important;
            position: relative;
            transition: color .2s ease;
        }
        .lov-nav .nav-link:hover { color: var(--lov-accent) !important; }
        .lov-nav .nav-link::after {
            content: "";
            position: absolute;
            left: 14px; right: 14px; bottom: 2px;
            height: 1px;
            background: var(--lov-accent);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .25s ease;
        }
        .lov-nav .nav-link:hover::after { transform: scaleX(1); }

        .lov-icon-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px; height: 40px;
            border-radius: 999px;
            color: var(--lov-ink);
            position: relative;
            transition: background .2s ease, color .2s ease;
            text-decoration: none;
        }
        .lov-icon-link:hover { background: #f1ece4; color: var(--lov-accent-dark); }

        .lov-cart-badge {
            position: absolute;
            top: 2px; right: 2px;
            min-width: 18px; height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            background: var(--lov-accent);
            color: #fff;
            font-size: 10px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .lov-user-toggle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px !important;
            border: 1px solid var(--lov-line);
            border-radius: 999px;
            font-size: 12px !important;
            letter-spacing: 0.12em;
        }
        .lov-user-toggle:hover { border-color: var(--lov-accent); }

        .dropdown-menu {
            border: 1px solid var(--lov-line);
            border-radius: 12px;
            box-shadow: 0 20px 40px -20px rgba(0,0,0,0.15);
            padding: 8px;
        }
        .dropdown-item {
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 14px;
        }
        .dropdown-item:hover { background: #f6f1ea; color: var(--lov-accent-dark); }

        .lov-auth-btn {
            font-size: 12px !important;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            padding: 8px 18px !important;
            border-radius: 999px;
        }
        .lov-auth-btn.ghost { color: var(--lov-ink) !important; }
        .lov-auth-btn.solid {
            background: var(--lov-ink);
            color: #fff !important;
        }
        .lov-auth-btn.solid:hover { background: var(--lov-accent-dark); }
        .lov-auth-btn.solid::after { display: none; }

        main.lov-main {
            flex: 1;
            padding: 40px 0 64px;
        }

        .lov-footer {
            border-top: 1px solid var(--lov-line);
            background: var(--lov-surface);
            padding: 28px 0;
            color: var(--lov-muted);
            font-size: 13px;
            margin-top: auto;
        }
        .lov-footer .nav-link {
            color: var(--lov-muted) !important;
            font-size: 12px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            padding: 4px 12px !important;
        }
        .lov-footer .nav-link:hover { color: var(--lov-accent-dark) !important; }

        @@media (max-width: 991px) {
            .lov-brand { font-size: 1.5rem; letter-spacing: 0.2em; }
            .lov-nav .nav-link::after { display: none; }
        }
    </style>
</head>
<body>
    <div class="lov-announce">Miễn phí giao hàng cho đơn từ 500.000₫ — Đổi trả trong 7 ngày</div>

    <header>
        <nav class="navbar navbar-expand-lg lov-nav">
            <div class="container">
                <a class="navbar-brand lov-brand" asp-controller="Home" asp-action="CustomerIndex">LOVSTORE</a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="CustomerIndex">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Sản phẩm</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == false)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Track">Tra cứu đơn hàng</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="lov-icon-link" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng">
                                <i class="bi bi-bag"></i>
                                @if (cartCount > 0)
                                {
                                    <span class="lov-cart-badge cart-count-badge">@cartCount</span>
                                }
                            </a>
                        </li>
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item dropdown ms-lg-2">
                                <a class="nav-link lov-user-toggle dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@userName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="Details" asp-route-id="@userId">
                                            <i class="bi bi-person me-2"></i>Thông tin người dùng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword" asp-route-id="@userId">
                                            <i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Orders" asp-action="UserOrders">
                                            <i class="bi bi-bag-check me-2"></i>Lịch sử đặt hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Users" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link lov-auth-btn ghost" asp-controller="Users" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <a class="nav-link lov-auth-btn solid" asp-controller="Users" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="lov-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="lov-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year LOVSTORE — Clothing Store. Crafted with care.</span>
            <ul class="nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Support" asp-action="Faq">Câu hỏi thường gặp</a></li>
                @* <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a></li> *@
            </ul>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
