@{
    ViewData["Title"] = "Tra cứu đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>Tra cứu đơn hàng</h2>

<form asp-action="Lookup" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label for="orderId" class="form-label">Mã đơn hàng</label>
        <input type="number" id="orderId" name="orderId" class="form-control" required />
    </div>

    <div class="mb-3">
        <label for="phone" class="form-label">Số điện thoại</label>
        <input type="tel" id="phone" name="phone" class="form-control" required />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Tra cứu</button>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="CustomerIndex">Trang chủ</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
